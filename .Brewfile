# Brewfile - Homebrew packages for dotfiles
# Usage: brew bundle --file=~/.Brewfile

# Taps
tap "homebrew/bundle"
tap "oven-sh/bun"

# ===== Formulae =====
brew "btop"
brew "oven-sh/bun/bun"
brew "claude-code"
brew "colima"
brew "composer"
brew "docker"
brew "docker-compose"
brew "docker-credential-helper"
brew "fastfetch"
brew "fzf"
brew "git"
brew "htop"
brew "k9s"
brew "node"
brew "nvm"
brew "pnpm"
brew "uv"
brew "wget"
brew "yarn"

# ===== Casks (GUI Applications) =====
cask "1password-cli"
cask "appcleaner"
cask "betterdisplay"
cask "deepl"
cask "ghostty"
cask "iterm2"
cask "karabiner-elements"
cask "laradumps"
cask "lens"
cask "medis"
cask "stats"
cask "switchhosts"
cask "telegram"
cask "visual-studio-code"

