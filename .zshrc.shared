# Shared zsh configuration - safe to commit to git
# Add this line to your .zshrc:
# [ -f "$HOME/.zshrc.shared" ] && source "$HOME/.zshrc.shared"

# Claude Code native binary path
export PATH="$HOME/.local/bin:$PATH"

if [ -f "$HOME/.agents/humanize-shell.sh" ]; then
  . "$HOME/.agents/humanize-shell.sh"
fi

# Claude Code mods (function-hook plugins). Desktop app sessions get no shell env, so settings.json env repeats this key
export CLAUDE_CODE_PLUGIN_DIRS="$HOME/.claude/mods/dev-dashboard"

# PostgreSQL client tools (libpq)
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# Go
export PATH="$PATH:$(go env GOPATH)/bin"

# Aliases
alias dotfiles='git --git-dir=$HOME/.dotfiles --work-tree=$HOME'
alias cc="claude"
alias cca="claude --enable-auto-mode"
alias ccd="claude --dangerously-skip-permissions"
alias hcc="headroom wrap claude"
alias cdx-cora="cd ~/Github/cora-app && codex -p auto --add-dir ~/Github/cora-sb"
alias icloud='cd ~/Library/Mobile\ Documents'
alias obsidian='cd ~/Library/Mobile\ Documents/iCloud~md~obsidian/Documents/eyedroot'

# Stage PostgreSQL port-forward (connect DB client to 127.0.0.1:15432)
alias pg-stage='kubectl --context tk-stage -n kollus-postgresql port-forward svc/postgresql 15432:5432'

# Bitwarden SSH agent — pick the first reachable socket + reset script.
# Bitwarden 2 (sandboxed) keeps its socket inside the app container; the old
# home-dir socket may linger stale and refuse connections, so probe both.
for _bw_sock in \
  "$HOME/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock" \
  "$HOME/.bitwarden-ssh-agent.sock"; do
  [ -S "$_bw_sock" ] || continue
  SSH_AUTH_SOCK="$_bw_sock" ssh-add -l >/dev/null 2>&1
  # exit 2 means the agent is unreachable; 0 and 1 both mean it answered.
  [ $? -eq 2 ] && continue
  export SSH_AUTH_SOCK="$_bw_sock"
  break
done
unset _bw_sock
alias bw-fix='~/.local/bin/bw-ssh-reset.sh'

# Zoxide - smarter cd command
# Usage: z <path>, zi (interactive selection with fzf)
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
fi

case "$-" in
  *i*)
    if command -v python3 >/dev/null 2>&1 && [ -f "$HOME/.agents/shell-flower.py" ]; then
      command python3 "$HOME/.agents/shell-flower.py"
    fi
    ;;
esac

# mise - runtime version manager
if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
fi

# Background lightness for the prompt, ~/.claude/statusline.sh and the
# dev-dashboard mod. They draw fixed hex colors that a terminal theme cannot
# remap, and terminals with different backgrounds (Ghostty, Herdr) share these
# files, so each shell asks its own terminal for the background color (OSC 11), as
# Claude Code's "auto" theme does. Unpeel keeps its pane appearance in
# app-appearance instead. Read once per shell: an appearance change reaches the
# next shell. Without an answer an inherited value stays.
# Sets REPLY to light or dark. Runs in the current shell, not in $(...), so
# print -z reaches this shell's first prompt.
terminal_background_appearance() {
  local reply char saved_stty
  REPLY=
  saved_stty=$(stty -g 2>/dev/null) || return 1
  # Echo off before asking, or the answer can land on screen before read runs.
  stty -echo -icanon 2>/dev/null
  printf '\e]11;?\e\\' > /dev/tty
  while read -r -s -k 1 -t 0.2 char; do
    reply+=$char
    [[ $reply == *$'\a' || $reply == *$'\e\\' ]] && break
  done
  stty "$saved_stty" 2>/dev/null
  # Keys typed while the shell was starting arrive before the answer; hand them
  # back to the first prompt.
  local typed=${reply%%$'\e]11;'*}
  [[ -n $typed ]] && print -z -- "$typed"
  [[ $reply =~ 'rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+)' ]] || return 1
  local -F red=$(( 0x$match[1] / (16.0 ** ${#match[1]} - 1) ))
  local -F green=$(( 0x$match[2] / (16.0 ** ${#match[2]} - 1) ))
  local -F blue=$(( 0x$match[3] / (16.0 ** ${#match[3]} - 1) ))
  (( 0.2126 * red + 0.7152 * green + 0.0722 * blue > 0.5 )) && REPLY=light || REPLY=dark
}

if [[ -o interactive && -t 0 && -t 1 ]]; then
  if [ "$TERM_PROGRAM" = "Unpeel" ]; then
    REPLY=$(cat "$HOME/.unpeel/app-appearance" 2>/dev/null)
  else
    terminal_background_appearance
  fi
  [[ $REPLY == (light|dark) ]] && export TERMINAL_APPEARANCE=$REPLY
fi

# Starship prompt
if command -v starship &> /dev/null; then
  # Starship's palette key is static, so a light terminal gets a generated copy
  # of the shared config with only the palette line swapped.
  starship_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/starship"
  if [ "$TERMINAL_APPEARANCE" = "light" ]; then
    mkdir -p "$starship_cache_dir"
    sed "s/^palette = 'phpstorm_dark'$/palette = 'herdr_paper'/" \
      "$HOME/.config/starship.toml" > "$starship_cache_dir/starship.light.toml"
    export STARSHIP_CONFIG="$starship_cache_dir/starship.light.toml"
  elif [[ "$STARSHIP_CONFIG" == "$starship_cache_dir/"* ]]; then
    # exec zsh and child shells inherit the export above from a shell that
    # started on the light appearance; drop it so the shared config applies.
    unset STARSHIP_CONFIG
  fi
  unset starship_cache_dir
  eval "$(starship init zsh)"
fi

# macOS SDK root (needed for pyenv install on macOS 26+ to link libSystem)
if [[ "$(uname)" == "Darwin" ]] && command -v xcrun &>/dev/null; then
  export SDKROOT="$(xcrun --sdk macosx --show-sdk-path)"
fi

# Pyenv
if command -v pyenv &>/dev/null || [ -d "$HOME/.pyenv" ]; then
  export PYENV_ROOT="$HOME/.pyenv"
  export PATH="$PYENV_ROOT/bin:$PATH"
  eval "$(pyenv init -)"
fi
