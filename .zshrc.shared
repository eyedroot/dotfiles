# Shared zsh configuration - safe to commit to git
# Add this line to your .zshrc:
# [ -f "$HOME/.zshrc.shared" ] && source "$HOME/.zshrc.shared"

# Claude Code native binary path
export PATH="$HOME/.local/bin:$PATH"

# PostgreSQL client tools (libpq)
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# Go
export PATH="$PATH:$(go env GOPATH)/bin"

# Aliases
alias dotfiles='git --git-dir=$HOME/.dotfiles --work-tree=$HOME'
alias cc="CLAUDE_CODE_NO_FLICKER=1 claude"
alias cca="CLAUDE_CODE_NO_FLICKER=1 claude --enable-auto-mode"
alias ccd="CLAUDE_CODE_NO_FLICKER=1 claude --dangerously-skip-permissions"
alias cdx-cora="cd ~/Github/cora-app && codex -p auto --add-dir ~/Github/cora-sb"
alias icloud='cd ~/Library/Mobile\ Documents'
alias obsidian='cd ~/Library/Mobile\ Documents/iCloud~md~obsidian/Documents/eyedroot'

# Zoxide - smarter cd command
# Usage: z <path>, zi (interactive selection with fzf)
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
fi

# Fastfetch - show system info on terminal start
if command -v fastfetch &> /dev/null; then
  fastfetch
fi

# mise - runtime version manager
if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
fi

# Starship prompt
if command -v starship &> /dev/null; then
  eval "$(starship init zsh)"
fi

# macOS SDK root (needed for pyenv install on macOS 26+ to link libSystem)
if [[ "$(uname)" == "Darwin" ]] && command -v xcrun &>/dev/null; then
  export SDKROOT="$(xcrun --sdk macosx --show-sdk-path)"
fi

# Pyenv
if command -v pyenv &>/dev/null || [ -d "$HOME/.pyenv" ]; then
  export PYENV_ROOT="$HOME/.pyenv"
  export PATH="$PYENV_ROOT/bin:$PATH"
  eval "$(pyenv init -)"
fi
