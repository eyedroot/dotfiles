# Shared zsh configuration - safe to commit to git
# Add this line to your .zshrc:
# [ -f "$HOME/.zshrc.shared" ] && source "$HOME/.zshrc.shared"

# Claude Code native binary path
export PATH="$HOME/.local/bin:$PATH"

# PostgreSQL client tools (libpq)
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# Go
export PATH="$PATH:$(go env GOPATH)/bin"

# Aliases
alias dotfiles='git --git-dir=$HOME/.dotfiles --work-tree=$HOME'
alias cc="claude"
alias cca="claude --enable-auto-mode"
alias ccd="claude --dangerously-skip-permissions"
alias hcc="headroom wrap claude"
alias cdx-cora="cd ~/Github/cora-app && codex -p auto --add-dir ~/Github/cora-sb"
alias icloud='cd ~/Library/Mobile\ Documents'
alias obsidian='cd ~/Library/Mobile\ Documents/iCloud~md~obsidian/Documents/eyedroot'

# Stage PostgreSQL port-forward (connect DB client to 127.0.0.1:15432)
alias pg-stage='kubectl --context tk-stage -n kollus-postgresql port-forward svc/postgresql 15432:5432'

# Bitwarden SSH agent — pick the first reachable socket + reset script.
# Bitwarden 2 (sandboxed) keeps its socket inside the app container; the old
# home-dir socket may linger stale and refuse connections, so probe both.
for _bw_sock in \
  "$HOME/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock" \
  "$HOME/.bitwarden-ssh-agent.sock"; do
  [ -S "$_bw_sock" ] || continue
  SSH_AUTH_SOCK="$_bw_sock" ssh-add -l >/dev/null 2>&1
  # exit 2 means the agent is unreachable; 0 and 1 both mean it answered.
  [ $? -eq 2 ] && continue
  export SSH_AUTH_SOCK="$_bw_sock"
  break
done
unset _bw_sock
alias bw-fix='~/.local/bin/bw-ssh-reset.sh'

# Zoxide - smarter cd command
# Usage: z <path>, zi (interactive selection with fzf)
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
fi

# Fastfetch - show system info on terminal start
if command -v fastfetch &> /dev/null; then
  fastfetch
fi

# mise - runtime version manager
if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
fi

# Starship prompt
if command -v starship &> /dev/null; then
  eval "$(starship init zsh)"
fi

# macOS SDK root (needed for pyenv install on macOS 26+ to link libSystem)
if [[ "$(uname)" == "Darwin" ]] && command -v xcrun &>/dev/null; then
  export SDKROOT="$(xcrun --sdk macosx --show-sdk-path)"
fi

# Pyenv
if command -v pyenv &>/dev/null || [ -d "$HOME/.pyenv" ]; then
  export PYENV_ROOT="$HOME/.pyenv"
  export PATH="$PYENV_ROOT/bin:$PATH"
  eval "$(pyenv init -)"
fi
