#!/usr/bin/env zsh
# Morning update routine
#   1. brew update && brew upgrade
#   2. ncu -g (parse output, run "npm -g install ..." it suggests)
#   3. claude update
#   4. pip3 install --upgrade graphifyy (prompt to run install hooks if upgraded)

set -u

hdr()  { print -P "\n%F{cyan}%B==> $1%b%f"; }
ok()   { print -P "%F{green}  ✓ $1%f"; }
warn() { print -P "%F{yellow}  ! $1%f"; }
err()  { print -P "%F{red}  ✗ $1%f"; }

# ---------- 1. Homebrew ----------
hdr "[1/4] Homebrew update & upgrade"
if command -v brew >/dev/null; then
  brew update
  brew upgrade
  ok "brew done"
else
  err "brew not found, skipping"
fi

# ---------- 2. Global npm packages (ncu) ----------
hdr "[2/4] Global npm packages (ncu -g)"
if command -v ncu >/dev/null; then
  ncu_out="$(ncu -g 2>&1)"
  print -- "$ncu_out"

  # ncu prints a line like `npm -g install pkg@ver pkg@ver ...` when there are upgrades
  upgrade_cmd="$(print -- "$ncu_out" | grep -E '^[[:space:]]*npm[[:space:]]+-g[[:space:]]+install' | head -1 | sed 's/^[[:space:]]*//')"

  if [[ -n "$upgrade_cmd" ]]; then
    warn "Running: $upgrade_cmd"
    eval "$upgrade_cmd"
    ok "global npm packages upgraded"
  else
    ok "all global npm packages up to date"
  fi
else
  err "ncu not found, skipping"
fi

# ---------- 3. Claude Code ----------
hdr "[3/4] Claude Code update"
if command -v claude >/dev/null; then
  claude update
  ok "claude update done"
else
  err "claude not found, skipping"
fi

# ---------- 4. graphifyy ----------
hdr "[4/4] pip3 upgrade graphifyy"
if command -v pip3 >/dev/null; then
  before="$(pip3 show graphifyy 2>/dev/null | awk '/^Version:/ {print $2}')"
  pip3 install --upgrade graphifyy
  after="$(pip3 show graphifyy 2>/dev/null | awk '/^Version:/ {print $2}')"

  if [[ -z "$after" ]]; then
    err "graphifyy install failed"
  elif [[ "$before" != "$after" ]]; then
    warn "graphifyy: ${before:-none} → ${after}"
    print ""
    print -P "%B  다음 명령을 이어서 실행하세요:%b"
    print "    graphify install"
    print "    graphify claude install"
  else
    ok "graphifyy already up to date (${after})"
  fi
else
  err "pip3 not found, skipping"
fi

hdr "All done."
