#!/usr/bin/env zsh
# Morning update routine
#   1. brew update && brew upgrade
#   2. Node.js latest LTS via nvm (migrates global packages, updates default alias)
#   3. Codex CLI standalone update
#   4. ncu -g (parse output, run "npm -g install ..." it suggests)
#   5. claude update
#   6. herdr update

set -u

hdr()  { print -P "\n%F{cyan}%B==> $1%b%f"; }
ok()   { print -P "%F{green}  ✓ $1%f"; }
warn() { print -P "%F{yellow}  ! $1%f"; }
err()  { print -P "%F{red}  ✗ $1%f"; }

# ---------- 1. Homebrew ----------
hdr "[1/6] Homebrew update & upgrade"
if command -v brew >/dev/null; then
  brew update
  brew upgrade
  ok "brew done"
else
  err "brew not found, skipping"
fi

# ---------- 2. Node.js LTS (nvm) ----------
# Runs before the npm/ncu step so global packages land in the new node version.
hdr "[2/6] Node.js latest LTS via nvm"
export NVM_DIR="$HOME/.nvm"
if [[ -s "/opt/homebrew/opt/nvm/nvm.sh" ]]; then
  source "/opt/homebrew/opt/nvm/nvm.sh"
  node_latest="$(nvm version-remote --lts)"
  node_current="$(nvm version default)"
  if [[ "$node_latest" == "N/A" ]]; then
    err "could not resolve latest LTS from nodejs.org, skipping"
  elif [[ "$node_latest" == "$node_current" ]]; then
    ok "node already at latest LTS ($node_current)"
  else
    warn "upgrading node: $node_current -> $node_latest"
    if [[ "$node_current" == "N/A" ]]; then
      nvm install "$node_latest" --reinstall-packages-from=system &&
        nvm alias default "$node_latest" &&
        ok "node $node_latest installed (default alias set)" || err "node install failed"
    else
      nvm install "$node_latest" --reinstall-packages-from="$node_current" &&
        nvm alias default "$node_latest" &&
        ok "node upgraded to $node_latest (globals migrated, default alias updated)" ||
        err "node upgrade failed"
    fi
  fi
else
  err "nvm not found, skipping"
fi

# ---------- 3. Codex CLI ----------
hdr "[3/6] Codex CLI update"
if command -v curl >/dev/null; then
  if (
    set -o pipefail
    curl -fsSL https://chatgpt.com/codex/install.sh |
      CODEX_NON_INTERACTIVE=1 sh
  ); then
    ok "Codex CLI update done ($(codex --version 2>/dev/null))"
  else
    err "Codex CLI update failed"
  fi
else
  err "curl not found, skipping"
fi

# ---------- 4. Global npm packages (ncu) ----------
hdr "[4/6] Global npm packages (ncu -g)"
if command -v ncu >/dev/null; then
  ncu_out="$(ncu -g 2>&1)"
  print -- "$ncu_out"

  # ncu prints a line like `npm -g install pkg@ver pkg@ver ...` when there are upgrades
  upgrade_cmd="$(print -- "$ncu_out" | grep -E '^[[:space:]]*npm[[:space:]]+-g[[:space:]]+install' | head -1 | sed 's/^[[:space:]]*//')"

  if [[ -n "$upgrade_cmd" ]]; then
    warn "Running: $upgrade_cmd"
    eval "$upgrade_cmd"
    ok "global npm packages upgraded"
  else
    ok "all global npm packages up to date"
  fi
else
  err "ncu not found, skipping"
fi

# ---------- 5. Claude Code ----------
hdr "[5/6] Claude Code update"
if command -v claude >/dev/null; then
  claude update
  ok "claude update done"
else
  err "claude not found, skipping"
fi

# ---------- 6. herdr ----------
hdr "[6/6] herdr update"
if command -v herdr >/dev/null; then
  herdr update
  ok "herdr update done"
else
  err "herdr not found, skipping"
fi

hdr "All done."
