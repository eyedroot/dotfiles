// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "title_bar": {
    "show_branch_status_icon": true
  },
  "active_pane_modifiers": {
    "border_size": 1.0,
    "inactive_opacity": 0.8,
  },
  "disable_ai": false,
  "terminal": {
    "font_size": 14.0,
  },
  "ui_font_weight": 400.0,
  "diff_view_style": "unified",
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true,
  },
  "multi_cursor_modifier": "alt",
  "text_rendering_mode": "platform_default",
  "project_panel": {
    "indent_size": 25.0,
    "hide_root": false,
    "bold_folder_labels": true,
    "dock": "left",
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "cursor_shape": "bar",
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Latte",
    "dark": "JetBrains New UI Icons (Light)",
  },
  "base_keymap": "JetBrains",
  "buffer_font_size": 15.0,
  "buffer_line_height": {
    "custom": 1.3,
  },
  "buffer_font_family": "Sarasa Mono K",
  "buffer_font_features": {
    "liga": true,
  },
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 15,
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "vim_mode": false,
  "theme": {
    "mode": "dark",
    "light": "Nord Light",
    "dark": "Ayu Dark",
  },
  "minimap": {
    "show": "always",
    "display_in": "active_editor",
    "thumb": "always",
    "thumb_border": "left_open",
    "current_line_highlight": "line",
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors",
  },
  "inlay_hints": {
    "enabled": true,
    "show_parameter_hints": false,
    "show_type_hints": false,
  },
  "agent": {
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-5.5",
      "enable_thinking": true,
      "effort": "medium"
    },
    "tool_permissions": {
      "tools": {
        "search_web": {
          "default": "allow"
        }
      }
    },
    "sidebar_side": "right",
    "dock": "left",
    "commit_message_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o",
    },
  },
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },
  "auto_install_extensions": {
    "html": true,
    "php": true,
    "blade": true,
    "tailwindcss": true,
    "env": true,
    "sql": true,
    "vue": true,
    "toml": true,
    "xml": true,
    "emmet": true,
    "scss": true,
    "deno": true,
    "java": true,
    "kotlin": true,
    "log": true,
    "csv": true,
    "graphql": true,
    "dockerfile": true,
    "make": true,
  },
  "languages": {
    "PHP": {
      "language_servers": ["intelephense", "!phpactor", "!phptools", "..."],
    },
  },
  "lsp": {
    "intelephense": {
      "initialization_options": {
        "licenceKey": "~/.config/intelephese_license.txt",
      },
    },
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "php": "html",
          "blade": "html",
        },
        "experimental": {
          "classRegex": [
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            "class=\\\"([^\\\"]*)\\\"",
            "@class\\(\\[([^\\]]*)\\]\\)",
          ],
        },
      },
    },
  },
  "theme_overrides": {
    "Warm Light": {
      "ignored": "#a08060",
    },
  },
}
