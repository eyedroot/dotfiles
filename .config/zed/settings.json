// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "code_lens": "on",
  "cli_default_open_behavior": "new_window",
  "redact_private_values": false,
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "active_pane_modifiers": {
    "border_size": 1.0,
    "inactive_opacity": 0.8,
  },
  "disable_ai": false,
  "terminal": {
    "font_size": 14.0,
  },
  "ui_font_weight": 400.0,
  "diff_view_style": "unified",
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "git_panel": {
    "sort_by": "name",
    "group_by": "none",
    "dock": "left",
    "tree_view": true,
  },
  "multi_cursor_modifier": "alt",
  "text_rendering_mode": "platform_default",
  "project_panel": {
    "indent_size": 25.0,
    "hide_root": false,
    "bold_folder_labels": true,
    "dock": "left",
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "cursor_shape": "bar",
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "JetBrains Icons Light",
  },
  "base_keymap": "JetBrains",
  "buffer_font_size": 14.5,
  "buffer_line_height": {
    "custom": 1.3,
  },
  "buffer_font_family": "Sarasa Mono K",
  "buffer_font_features": {
    "liga": true,
  },
  "ui_font_family": "Pretendard",
  "ui_font_size": 15,
  "format_on_save": "off",
  "autosave": "on_focus_change",
  "vim_mode": false,
  "theme": {
    "mode": "light",
    "light": "One Light",
    "dark": "BlackFox",
  },
  "minimap": {
    "show": "always",
    "display_in": "active_editor",
    "thumb": "always",
    "thumb_border": "left_open",
    "current_line_highlight": "line",
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors",
  },
  "inlay_hints": {
    "enabled": true,
    "show_parameter_hints": false,
    "show_type_hints": false,
  },
  "agent": {
    "flexible": true,
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-5",
      "enable_thinking": true,
      "effort": "high",
    },
    "tool_permissions": {
      "tools": {
        "search_web": {
          "default": "allow",
        },
      },
    },
    "sidebar_side": "right",
    "dock": "right",
    "commit_message_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o",
    },
  },
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },
  "auto_install_extensions": {
    "html": true,
    "php": true,
    "blade": true,
    "tailwindcss": true,
    "env": true,
    "sql": true,
    "vue": true,
    "toml": true,
    "xml": true,
    "emmet": true,
    "scss": true,
    "deno": true,
    "java": true,
    "kotlin": true,
    "log": true,
    "csv": true,
    "graphql": true,
    "dockerfile": true,
    "make": true,
  },
  "languages": {
    "PHP": {
      // laravel-assist owns PHP intelligence here. intelephense is disabled
      // (leading "!") so it no longer runs; re-enable it by removing the "!"
      // if you want general PHP completion/diagnostics/hover back alongside it.
      "language_servers": [
        "phpantom_lsp",
        "laravel-assist",
        "!phpactor",
        "!phptools",
        "!intelephense",
        "...",
      ],
    },
  },
  "lsp": {
    "laravel-assist": {
      // Go to Implementation (shift-f12) for PHP classes/interfaces/traits/enums.
      // On by default; set to false to defer implementation navigation to
      // another PHP language server.
      "initialization_options": {
        "implementations": { "enabled": true },
      },
    },
    // Kept for easy re-enabling; ignored while intelephense is disabled above.
    "intelephense": {
      "initialization_options": {
        "licenceKey": "~/.config/intelephese_license.txt",
      },
    },
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "php": "html",
          "blade": "html",
        },
        "experimental": {
          "classRegex": [
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            "class=\\\"([^\\\"]*)\\\"",
            "@class\\(\\[([^\\]]*)\\]\\)",
          ],
        },
      },
    },
  },
  "theme_overrides": {},
}
