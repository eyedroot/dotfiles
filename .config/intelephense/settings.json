{
    "intelephense.files.maxSize": 1000000,
    "intelephense.files.exclude": [
        "**/vendor/**/{Tests,tests}/**",
        "**/vendor/**/{docs,Docs}/**",
        "**/node_modules/**",
        "**/.git/**",
        "**/storage/**",
        "**/bootstrap/cache/**"
    ],
    "intelephense.telemetry.enabled": false,
    "intelephense.completion.maxItems": 100,
    "intelephense.references.exclude": [
        "**/vendor/**"
    ]
}
