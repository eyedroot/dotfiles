# Ghostty Terminal Configuration

# Font settings
font-family = "Sarasa Mono K"
# font-family = "Sarasa Mono Slab K"
# font-family = "D2Coding Ligature"
# font-family = "Geist Mono"
font-size = 15
font-thicken = true
adjust-cell-height = 7%

# Theme
# Colors follow PhpStorm's Rider Melon Light below, so no built-in theme is set.
# theme = Catppuccin Mocha
# theme = Gruvbox Light Hard

# Window settings. Equal padding on every side, the leftover space the cell
# grid cannot fill spread evenly, and the padding painted in the nearest
# cell's background so herdr's sidebar and a docked pane run to the window
# edge instead of stopping at a cream frame. (`extend` leaves the bottom
# padding in the default background while the last row has any default-
# background cell; `extend-always` would paint it per column.)
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
window-padding-color = extend
window-decoration = true
window-title-font-family = "Sarasa Mono K"

# Background: PhpStorm's editor white and text color. Opaque on purpose:
# windows showing through, even blurred, soften glyph edges on a light
# background.
background = #FFFFFF
foreground = #202020
background-opacity = 1
unfocused-split-opacity = 1
unfocused-split-fill = #F7F7F7

# Split pane divider (PhpStorm tool window separator)
split-divider-color = #CCCCCC

# macOS specific
macos-titlebar-style = native
macos-option-as-alt = true
window-save-state = always

# Cursor
cursor-color = #202020
cursor-text = #FFFFFF
cursor-style = block
cursor-style-blink = true

# Selection (PhpStorm editor selection)
selection-background = #B8D9FF
selection-foreground = cell-foreground

# ANSI colors from the Rider Melon Light console palette. 3, 7 and 15 are
# darkened because the originals fall to 3:1 or less on white.
palette = 0=#383838
palette = 1=#D91400
palette = 2=#248700
palette = 3=#9A6D00
palette = 4=#0F54D6
palette = 5=#941290
palette = 6=#00855F
palette = 7=#767676
palette = 8=#656565
palette = 9=#AD0F00
palette = 10=#1B6600
palette = 11=#826A00
palette = 12=#0E3E9E
palette = 13=#61005E
palette = 14=#005C43
palette = 15=#ADADAD

# Shell integration
shell-integration = zsh

# Scrollback
scrollback-limit = 10000

# Mouse
mouse-hide-while-typing = true

# Copy/Paste
copy-on-select = clipboard

# Quit/close confirmation (CMD+Q 포함)
# true  = 셸 작업 중일 때만 확인
# always = 항상 확인
confirm-close-surface = true

# Split pane focus navigation
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:top
keybind = ctrl+shift+down=goto_split:bottom

# Local overrides (machine-specific, not tracked by git)
config-file = ~/.config/ghostty/config.local
