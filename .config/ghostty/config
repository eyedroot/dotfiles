# Ghostty Terminal Configuration

# Font settings
font-family = "Sarasa Mono K"
font-size = 14.5
font-thicken = true
adjust-cell-height = 10%

# Theme
theme = Bluloco Light
# theme = Catppuccin Frappe
# theme = 0x96f

# Window settings
window-padding-x = 16
window-padding-y = 16
window-decoration = true
window-title-font-family = "Sarasa Mono K"

# Background (modern glassmorphic style)
background-opacity = 1
background-blur-radius = 20
unfocused-split-opacity = 0

# macOS specific
macos-titlebar-style = tabs
macos-option-as-alt = true
window-save-state = always

# Cursor
cursor-style = block
cursor-style-blink = true

# Shell integration
shell-integration = zsh

# Scrollback
scrollback-limit = 10000

# Mouse
mouse-hide-while-typing = true

# Copy/Paste
copy-on-select = clipboard
confirm-close-surface = false

# Split pane focus navigation
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:top
keybind = alt+down=goto_split:bottom
