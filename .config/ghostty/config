# Ghostty Terminal Configuration

# Font settings
font-family = "Sarasa Mono K"
# font-family = "Sarasa Mono Slab K"
# font-family = "D2Coding Ligature"
# font-family = "Geist Mono"
font-size = 15
font-thicken = true
adjust-cell-height = 20%

# Theme
theme = Catppuccin Latte
# theme = Bluloco Light
# theme = Catppuccin Frappe
# theme = 0x96f
# theme = Catppuccin Mocha

# Window settings
window-padding-x = 16
window-padding-y = 4
window-decoration = true
window-title-font-family = "Sarasa Mono K"

# Background (warm light yellow - easy on the eyes)
background = #FEFCF3
foreground = #2E3440
# Opaque on purpose: windows showing through, even blurred, soften glyph edges.
background-opacity = 1
unfocused-split-opacity = 1
unfocused-split-fill = #F0EDE4

# Split pane divider
split-divider-color = #D5CEC0

# macOS specific
macos-titlebar-style = native
macos-option-as-alt = true
window-save-state = always

# Cursor
cursor-color = #4A90D9
cursor-text = #FEFCF3
cursor-style = block
cursor-style-blink = true

# Selection
selection-background = #D6EDDF
selection-foreground = #3B4252

# ANSI color overrides (warm yellow + blue + green palette)
palette = 0=#2E3440
palette = 1=#A83F4B
palette = 2=#3A7650
palette = 3=#8A5D12
palette = 4=#2B62A0
palette = 5=#74479A
palette = 6=#2A7478
palette = 7=#857E71
palette = 8=#636A79
palette = 9=#B4502A
palette = 10=#2E7F5A
palette = 11=#9A6A00
palette = 12=#3572B8
palette = 13=#8E4A8A
palette = 14=#22788A
palette = 15=#A9A294

# Shell integration
shell-integration = zsh

# Scrollback
scrollback-limit = 10000

# Mouse
mouse-hide-while-typing = true

# Copy/Paste
copy-on-select = clipboard

# Quit/close confirmation (CMD+Q 포함)
# true  = 셸 작업 중일 때만 확인
# always = 항상 확인
confirm-close-surface = true

# Split pane focus navigation
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:top
keybind = ctrl+shift+down=goto_split:bottom

# Local overrides (machine-specific, not tracked by git)
config-file = ~/.config/ghostty/config.local
