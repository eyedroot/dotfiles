sandbox_mode = "workspace-write"
approval_policy = "on-request"
approvals_reviewer = "auto_review"

model = "gpt-6-astra"
model_reasoning_effort = "high"
personality = "pragmatic"
project_doc_fallback_filenames = ["AGENTS.local.md"]

developer_instructions = """
For Codex tasks that use Computer Use:
- Before prolonged Computer Use, at major task transitions, before adding tabs or increasing screen activity, and whenever responsiveness degrades, briefly check CPU load, memory pressure, and existing workloads with lightweight read-only checks. Check at these boundaries rather than on every click; keep the checks themselves inexpensive.
- Prefer purpose-built tools, APIs, or CLIs when they support the task. Reuse suitable browser tabs and sessions, and process pages sequentially. Accept slower results to keep the computer responsive rather than increasing parallel browser or screen activity.
- Capture screenshots only when needed to inspect the state or verify a result. Reuse available state when it is still valid, and avoid redundant screenshots, continuous monitoring, and high-frequency state or resource polling.
- When resource pressure is high, stop adding work and reduce this task's activity. After verifying ownership, normally close unneeded tabs and stop idle services created by this task while preserving data and login sessions. Do not stop other chats' development servers, OrbStack, shared services, or processes of uncertain origin.
"""

[notice.model_migrations]
"gpt-5.1-codex-max" = "gpt-5.3-codex"
"gpt-5.2-codex" = "gpt-5.3-codex"

[mcp_servers.expo-mcp]
url = "https://mcp.expo.dev/mcp"

[mcp_servers.ref-tools]
url = "https://server.smithery.ai/@ref-tools/ref-tools-mcp/mcp"
enabled = false

[mcp_servers.context7]
command = "npx"
args = ["-y", "@upstash/context7-mcp"]

[mcp_servers.figma-mcp-go]
command = "npx"
args = ["-y", "@vkhanhqui/figma-mcp-go"]

[plugins."github@openai-curated"]
enabled = true

[plugins."documents@openai-primary-runtime"]
enabled = true

[plugins."spreadsheets@openai-primary-runtime"]
enabled = true

[plugins."presentations@openai-primary-runtime"]
enabled = true

[plugins."atlassian-rovo@openai-curated"]
enabled = true

[plugins."codex-security@openai-curated"]
enabled = true

[plugins."remotion@openai-curated"]
enabled = true

[plugins."workflow@catenoid-tools"]
enabled = true

[plugins."supabase@openai-curated"]
enabled = true

[plugins."sentry@openai-curated"]
enabled = true

[plugins."hyperframes@openai-curated"]
enabled = true

[plugins."browser-use@openai-bundled"]
enabled = true

[features]
memories = false
chronicle = false

[memories]
no_memories_if_mcp_or_web_search = true

[tui]
status_line = ["project-name", "git-branch", "model-with-reasoning", "status", "context-remaining", "context-used"]

[tui.model_availability_nux]
"gpt-5.5" = 4

[profiles.auto]
approval_policy = "never"
sandbox_mode = "workspace-write"
