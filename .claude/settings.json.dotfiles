{
  "model": "opus[1m]",
  "mcpServers": {
    "ray-app": {
      "type": "http",
      "url": "http://localhost:2411/mcp"
    }
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "WebFetch",
      "WebSearch",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(node:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(pwd:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(xargs:*)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "default"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "laravel-simplifier@laravel": true
  },
  "extraKnownMarketplaces": {},
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "language": "korean",
  "outputStyle": "fluent-korean:fluent-korean",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowUnixSockets": [
        "~/.bitwarden-ssh-agent.sock"
      ]
    },
    "filesystem": {
      "allowRead": [
        "~/.ssh/known_hosts",
        "~/.ssh/config",
        "~/.config/gh/hosts.yml"
      ],
      "allowWrite": ["~/.dotfiles/"]
    }
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "exit 0"
          }
        ]
      }
    ]
  }
}
