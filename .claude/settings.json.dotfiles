{
  "model": "opus[1m]",
  "mcpServers": {
    "ray-app": {
      "type": "http",
      "url": "http://localhost:2411/mcp"
    }
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "WebFetch",
      "WebSearch",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(node:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(pwd:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(xargs:*)",
      "Bash(agent-desktop skills:*)",
      "Bash(agent-desktop snapshot:*)",
      "Bash(agent-desktop find:*)",
      "Bash(agent-desktop get:*)",
      "Bash(agent-desktop is:*)",
      "Bash(agent-desktop status:*)",
      "Bash(agent-desktop list-apps:*)",
      "Bash(agent-desktop list-windows:*)",
      "Bash(agent-desktop wait:*)"
    ],
    "deny": [],
    "ask": [
      "Bash(agent-desktop click:*)",
      "Bash(agent-desktop type:*)",
      "Bash(agent-desktop set-value:*)",
      "Bash(agent-desktop press:*)",
      "Bash(agent-desktop clipboard-get:*)",
      "Bash(agent-desktop clipboard-set:*)",
      "Bash(agent-desktop launch:*)",
      "Bash(agent-desktop close-app:*)"
    ],
    "defaultMode": "default"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "laravel-simplifier@laravel": true
  },
  "extraKnownMarketplaces": {},
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/dev-dashboard"
  },
  "language": "korean",
  "outputStyle": "default",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowUnixSockets": [
        "~/.bitwarden-ssh-agent.sock",
        "~/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock"
      ]
    },
    "filesystem": {
      "allowRead": [
        "~/.ssh/known_hosts",
        "~/.ssh/config",
        "~/.config/gh/hosts.yml"
      ],
      "allowWrite": [
        "~/.dotfiles/"
      ]
    }
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.agents/hooks/zsh-var-modifier-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
