{
  "model": "opus",
  "mcpServers": {
    "ray-app": {
      "type": "http",
      "url": "http://localhost:2411/mcp"
    }
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "WebFetch",
      "WebSearch",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(node:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(pwd:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(xargs:*)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "default"
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir'); project=$(basename \"$cwd\"); style=$(echo \"$input\" | jq -r '.output_style.name // \"default\"'); vim_mode=$(echo \"$input\" | jq -r '.vim.mode // empty'); git_info=\"\"; if git -C \"$cwd\" -c core.useBuiltinFSMonitor=false rev-parse --git-dir > /dev/null 2>&1; then branch=$(git -C \"$cwd\" -c core.useBuiltinFSMonitor=false rev-parse --abbrev-ref HEAD 2>/dev/null); if ! git -C \"$cwd\" -c core.useBuiltinFSMonitor=false diff-index --quiet HEAD -- 2>/dev/null; then git_info=$(printf \" \\033[38;5;249m|\\033[0m \\033[38;5;175m%s\\033[0m \\033[38;5;210m*\\033[0m\" \"$branch\"); else git_info=$(printf \" \\033[38;5;249m|\\033[0m \\033[38;5;175m%s\\033[0m\" \"$branch\"); fi; fi; usage=$(echo \"$input\" | jq '.context_window.current_usage'); ctx_info=\"\"; if [ \"$usage\" != \"null\" ]; then current=$(echo \"$usage\" | jq '.input_tokens + .cache_creation_input_tokens + .cache_read_input_tokens'); size=$(echo \"$input\" | jq '.context_window.context_window_size'); pct=$((current * 100 / size)); bar_color=\"\\033[38;5;73m\"; filled=$((pct / 10)); empty=$((10 - filled)); bar=\"\"; for ((i=0; i<filled; i++)); do bar+=\"#\"; done; for ((i=0; i<empty; i++)); do bar+=\"-\"; done; ctx_info=$(printf \" \\033[38;5;249m|\\033[0m %b[%s]\\033[0m \\033[38;5;249m%d%%\\033[0m\" \"$bar_color\" \"$bar\" \"$pct\"); fi; style_info=\"\"; if [ \"$style\" != \"default\" ]; then style_info=$(printf \" \\033[38;5;249m|\\033[0m \\033[38;5;133m%s\\033[0m\" \"$style\"); fi; vim_info=\"\"; if [ -n \"$vim_mode\" ]; then if [ \"$vim_mode\" = \"NORMAL\" ]; then vim_info=$(printf \" \\033[38;5;249m|\\033[0m \\033[38;5;117mNORMAL\\033[0m\"); else vim_info=$(printf \" \\033[38;5;249m|\\033[0m \\033[38;5;114mINSERT\\033[0m\"); fi; fi; printf \"\\033[38;5;133m%s\\033[0m%s \\033[38;5;249m|\\033[0m \\033[38;5;117m%s\\033[0m%s%s%s\" \"$project\" \"$git_info\" \"$model\" \"$ctx_info\" \"$style_info\" \"$vim_info\""
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "laravel-simplifier@laravel": true
  },
  "alwaysThinkingEnabled": true,
  "language": "korean",
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "exit 0"
          }
        ]
      }
    ]
  }
}
